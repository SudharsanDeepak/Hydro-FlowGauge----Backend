# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=your_mongodb_connection_string

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# JWT
JWT_SECRET=your_jwt_secret_key

# Email Configuration (Brevo/Sendinblue)
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_verified_sender_email
SENDER_NAME=Hydro-FlowGauge

# SMTP Configuration (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your_smtp_login
SMTP_PASSWORD=your_smtp_password

# ThingSpeak Configuration
THINGSPEAK_READ_API_KEY=your_thingspeak_read_api_key
THINGSPEAK_WRITE_API_KEY=your_thingspeak_write_api_key
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.netlify.app
